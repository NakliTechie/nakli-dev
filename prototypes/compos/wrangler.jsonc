{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nakli-compos-relay",
  "main": "./relay-worker.mjs",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "compos-relay.naklios.dev",
      "custom_domain": true
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/compos-relay.mjs", "**/setup-local-tls.sh"],
      "fallthrough": true
    }
  ],
  "minify": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
